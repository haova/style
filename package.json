{
  "name": "@haova/style",
  "version": "1.0.0",
  "type": "module",
  "description": "A Configurable Styling Framework",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "dev": "vite playground --open",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haova/style.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/haova/style/issues"
  },
  "homepage": "https://github.com/haova/style#readme",
  "devDependencies": {
    "prettier": "3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
